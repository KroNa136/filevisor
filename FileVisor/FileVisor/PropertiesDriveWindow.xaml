<Window x:Name="propertiesDriveWindow" x:Class="FileVisor.PropertiesDriveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FileVisor"
        mc:Ignorable="d"
        Title="Свойства диска" Icon="{StaticResource PropertiesIcon}" Height="388" Width="470" ResizeMode="CanMinimize" ShowInTaskbar="True" FontSize="16" WindowStyle="SingleBorderWindow" BorderThickness="1" BorderBrush="{StaticResource DarkBlueColorBrush}" RenderOptions.EdgeMode="Aliased" RenderOptions.ClearTypeHint="Enabled">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="5" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="wrapper" Style="{StaticResource LightPanel}">
        <Grid x:Name="propertiesDriveWindowGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <DockPanel x:Name="titleBar" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Style="{StaticResource LightPanel}" Focusable="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Image Style="{StaticResource SmallIcon}" Source="{StaticResource PropertiesIcon}"/>
                    <TextBlock x:Name="titleTextBlock" Style="{StaticResource TitleTextBlock}" Text="Свойства диска"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" FlowDirection="RightToLeft">
                    <Button x:Name="closeButton" Grid.Column="1" Style="{StaticResource TitleBarCloseButton}" WindowChrome.IsHitTestVisibleInChrome="True" Click="closeButton_Click">
                        <Image Style="{StaticResource SmallIconWithoutLabel}" Source="{StaticResource CloseIcon}"/>
                    </Button>
                    <Button x:Name="restoreButton" Grid.Column="1" Style="{StaticResource TitleBarButton}" WindowChrome.IsHitTestVisibleInChrome="True" Click="restoreButton_Click" Visibility="Collapsed">
                        <Image Style="{StaticResource SmallIconWithoutLabel}" Source="{StaticResource RestoreIcon}"/>
                    </Button>
                    <Button x:Name="maximizeButton" Grid.Column="1" Style="{StaticResource TitleBarButton}" WindowChrome.IsHitTestVisibleInChrome="True" Click="maximizeButton_Click" Visibility="Visible" IsEnabled="False">
                        <Image Style="{StaticResource SmallIconWithoutLabel}" Source="{StaticResource MaximizeIcon}"/>
                    </Button>
                    <Button x:Name="minimizeButton" Grid.Column="1" Style="{StaticResource TitleBarButton}" WindowChrome.IsHitTestVisibleInChrome="True" Click="minimizeButton_Click">
                        <Image Style="{StaticResource SmallIconWithoutLabel}" Source="{StaticResource MinimizeIcon}"/>
                    </Button>
                </StackPanel>
            </DockPanel>
            <StackPanel x:Name="mainPanel" Grid.Row="1" Orientation="Vertical" Style="{StaticResource LightPanel}">
                <Grid Margin="5 5 5 5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="20"/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition Height="20"/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Image Grid.Column="0" Grid.Row="0" Style="{StaticResource LargeIcon}" HorizontalAlignment="Left" Source="{Binding Icon, Converter={StaticResource IconToImageConverter}}"/>
                    <TextBlock Grid.Column="1" Grid.Row="0" Style="{StaticResource InlineTextBlock}" FontWeight="Light" FontSize="24" Height="40" Text="{Binding Name}"/>
                    <Separator Grid.ColumnSpan="2" Grid.Row="1" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="0" Grid.Row="2" Style="{StaticResource InlineTextBlock}" Text="Тип:"/>
                    <TextBlock Grid.Column="1" Grid.Row="2" Style="{StaticResource InlineTextBlock}" Text="{Binding Type}"/>
                    <TextBlock Grid.Column="0" Grid.Row="3" Style="{StaticResource InlineTextBlock}" Text="Файловая система:"/>
                    <TextBlock Grid.Column="1" Grid.Row="3" Style="{StaticResource InlineTextBlock}" Text="{Binding FileSystem}"/>
                    <Separator Grid.ColumnSpan="2" Grid.Row="4" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="0" Grid.Row="5" Style="{StaticResource InlineTextBlock}" Text="Занято:"/>
                    <TextBlock Grid.Column="1" Grid.Row="5" Style="{StaticResource InlineTextBlock}" Text="{Binding UsedSpace}"/>
                    <TextBlock Grid.Column="0" Grid.Row="6" Style="{StaticResource InlineTextBlock}" Text="Свободно:"/>
                    <TextBlock Grid.Column="1" Grid.Row="6" Style="{StaticResource InlineTextBlock}" Text="{Binding AvailableSpace}"/>
                    <TextBlock Grid.Column="0" Grid.Row="7" Style="{StaticResource InlineTextBlock}" Text="Всего:"/>
                    <TextBlock Grid.Column="1" Grid.Row="7" Style="{StaticResource InlineTextBlock}" Text="{Binding TotalSpace}"/>
                </Grid>
            </StackPanel>
            <Grid x:Name="buttonPanel" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" Style="{StaticResource LightPanel}" Focusable="False">
                <Button x:Name="okButton" Style="{StaticResource TextButton}" HorizontalAlignment="Center" IsDefault="True" Click="okButton_Click">
                    <TextBlock Text="ОК"/>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
