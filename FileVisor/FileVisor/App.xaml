<Application x:Class="FileVisor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:localconverters="clr-namespace:FileVisor.Converters"
             StartupUri="MainWindow.xaml"
    xmlns:theme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero2">
    <Application.Resources>
        <!-- #region Converters -->
        <localconverters:BooleanToStringConverter x:Key="BooleanToStringConverter"/>
        <localconverters:DateTimeToStringConverter x:Key="DateTimeToStringConverter"/>
        <localconverters:EmptyStringToDashConverter x:Key="EmptyStringToDashConverter"/>
        <localconverters:IconToImageConverter x:Key="IconToImageConverter"/>
        <localconverters:IsCutToOpacityConverter x:Key="IsCutToOpacityConverter"/>
        <!-- #endregion -->
        <!-- #region Images -->
        <BitmapImage x:Key="BackIcon" UriSource="/Resources/back.png"/>
        <BitmapImage x:Key="CloseIcon" UriSource="/Resources/close.png"/>
        <BitmapImage x:Key="CopyIcon" UriSource="/Resources/copy.png"/>
        <BitmapImage x:Key="CopyPathIcon" UriSource="/Resources/copy_path.png"/>
        <BitmapImage x:Key="CreateIcon" UriSource="/Resources/create.png"/>
        <BitmapImage x:Key="CutIcon" UriSource="/Resources/cut.png"/>
        <BitmapImage x:Key="DeleteIcon" UriSource="/Resources/delete.png"/>
        <BitmapImage x:Key="EditIcon" UriSource="/Resources/edit.png"/>
        <BitmapImage x:Key="ErrorIcon" UriSource="/Resources/error.png"/>
        <BitmapImage x:Key="ForwardIcon" UriSource="/Resources/forward.png"/>
        <BitmapImage x:Key="GoIcon" UriSource="/Resources/go.png"/>
        <BitmapImage x:Key="HomeIcon" UriSource="/Resources/home.png"/>
        <BitmapImage x:Key="InvertSelectionIcon" UriSource="/Resources/invert_selection.png"/>
        <BitmapImage x:Key="Logo" UriSource="/Resources/logo_96x96.png"/>
        <BitmapImage x:Key="MaximizeIcon" UriSource="/Resources/maximize.png"/>
        <BitmapImage x:Key="MinimizeIcon" UriSource="/Resources/minimize.png"/>
        <BitmapImage x:Key="PasteIcon" UriSource="/Resources/paste.png"/>
        <BitmapImage x:Key="PropertiesIcon" UriSource="/Resources/properties.png"/>
        <BitmapImage x:Key="QuestionIcon" UriSource="/Resources/question.png"/>
        <BitmapImage x:Key="RefreshIcon" UriSource="/Resources/refresh.png"/>
        <BitmapImage x:Key="RemoveSelectionIcon" UriSource="/Resources/remove_selection.png"/>
        <BitmapImage x:Key="RenameIcon" UriSource="/Resources/rename.png"/>
        <BitmapImage x:Key="RestoreIcon" UriSource="/Resources/restore.png"/>
        <BitmapImage x:Key="SearchIcon" UriSource="/Resources/search.png"/>
        <BitmapImage x:Key="SelectAllIcon" UriSource="/Resources/select_all.png"/>
        <BitmapImage x:Key="SettingsIcon" UriSource="/Resources/settings.png"/>
        <BitmapImage x:Key="SortColumnIcon" UriSource="/Resources/sort_column.png"/>
        <BitmapImage x:Key="SortDirectionIcon" UriSource="/Resources/sort_direction.png"/>
        <BitmapImage x:Key="UpIcon" UriSource="/Resources/up.png"/>
        <BitmapImage x:Key="WarningIcon" UriSource="/Resources/warning.png"/>
        <!-- #endregion -->
        <!-- #region System Values -->
        <system:Boolean x:Key="TrueValue">true</system:Boolean>
        <system:Boolean x:Key="FalseValue">false</system:Boolean>
        <system:Double x:Key="DisabledElementOpacity">0.5</system:Double>
        <system:String x:Key="LogoIconPath">/Resources/logo_96x96.ico</system:String>
        <!-- #endregion -->
        <!-- #region Color Values -->
        <Color x:Key="DarkBlueColor">#FF42485B</Color>
        <!-- old: #FF444A61 -->
        <Color x:Key="LightBlueColor">#FF545D76</Color>
        <!-- old: #FF565D7A -->
        <Color x:Key="LighterBlueColor">#FF757B8E</Color>
        <!-- old: #FF767C94 -->
        <Color x:Key="DarkRedColor">#FFE81123</Color>
        <Color x:Key="LightRedColor">#FFF1707A</Color>
        <Color x:Key="LightGreyColor">#FFC9C9C9</Color>
        <Color x:Key="WhiteColor">#FFFFFFFF</Color>
        <Color x:Key="TransparentColor">Transparent</Color>
        <!-- #endregion -->
        <!-- #region Color Brushes -->
        <SolidColorBrush x:Key="DarkBlueColorBrush" Color="{StaticResource DarkBlueColor}"/>
        <SolidColorBrush x:Key="LightBlueColorBrush" Color="{StaticResource LightBlueColor}"/>
        <SolidColorBrush x:Key="LighterBlueColorBrush" Color="{StaticResource LighterBlueColor}"/>
        <SolidColorBrush x:Key="DarkRedColorBrush" Color="{StaticResource DarkRedColor}"/>
        <SolidColorBrush x:Key="LightRedColorBrush" Color="{StaticResource LightRedColor}"/>
        <SolidColorBrush x:Key="LightGreyColorBrush" Color="{StaticResource LightGreyColor}"/>
        <SolidColorBrush x:Key="WhiteColorBrush" Color="{StaticResource WhiteColor}"/>
        <SolidColorBrush x:Key="TransparentColorBrush" Color="{StaticResource TransparentColor}"/>
        <!-- #endregion -->
        <!-- #region Styles -->
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
        <Style x:Key="LightPanel" TargetType="Panel">
            <Setter Property="Background" Value="{StaticResource LightBlueColorBrush}"/>
        </Style>
        <Style x:Key="DarkPanel" TargetType="Panel">
            <Setter Property="Background" Value="{StaticResource DarkBlueColorBrush}"/>
        </Style>
        <Style x:Key="SmallIconButtonContainer" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Margin" Value="0 2 0 0"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource WhiteColorBrush}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="8 5 8 0"/>
            <Setter Property="Padding" Value="0 0 0 6"/>
            <Setter Property="Foreground" Value="{StaticResource WhiteColorBrush}"/>
            <Setter Property="Height" Value="32"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="InlineTextBlock">
            <Setter Property="Margin" Value="8 5 8 0"/>
            <Setter Property="Padding" Value="0 2 0 0"/>
            <Setter Property="Foreground" Value="{StaticResource WhiteColorBrush}"/>
            <Setter Property="Height" Value="32"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="ComboBoxTextBlock">
            <Setter Property="Margin" Value="10 3 10 0"/>
            <Setter Property="Padding" Value="0 2 0 0"/>
            <Setter Property="Foreground" Value="{StaticResource WhiteColorBrush}"/>
            <Setter Property="Height" Value="32"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="TitleTextBlock" BasedOn="{StaticResource InlineTextBlock}">
            <Style.Setters>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style.Setters>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                    <Setter Property="Opacity" Value="{StaticResource DisabledElementOpacity}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TextButton" TargetType="{x:Type Button}">
            <Style.Setters>
                <Setter Property="BorderBrush" Value="{StaticResource TransparentColorBrush}"/>
                <Setter Property="Background" Value="{StaticResource LightBlueColorBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource WhiteColorBrush}"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Width" Value="100"/>
                <Setter Property="Margin" Value="2 2 2 2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style.Setters>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="{StaticResource DisabledElementOpacity}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource LighterBlueColorBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource DarkBlueColorBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SmallIconButton" TargetType="{x:Type Button}">
            <Style.Setters>
                <Setter Property="BorderBrush" Value="{StaticResource TransparentColorBrush}"/>
                <Setter Property="Background" Value="{StaticResource LightBlueColorBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource WhiteColorBrush}"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Margin" Value="2 2 2 2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style.Setters>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="{StaticResource DisabledElementOpacity}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource LighterBlueColorBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource DarkBlueColorBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LargeIconButton" TargetType="{x:Type Button}">
            <Style.Setters>
                <Setter Property="BorderBrush" Value="{StaticResource TransparentColorBrush}"/>
                <Setter Property="Background" Value="{StaticResource LightBlueColorBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource WhiteColorBrush}"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Height" Value="104"/>
                <Setter Property="Margin" Value="2 4 2 4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style.Setters>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="{StaticResource DisabledElementOpacity}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource LighterBlueColorBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource DarkBlueColorBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TitleBarButton" TargetType="Button" BasedOn="{StaticResource SmallIconButton}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Margin" Value="0 2 0 2"/>
        </Style>
        <Style x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Style.Setters>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style.Setters>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DarkRedColorBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource LightRedColorBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="{StaticResource TransparentColorBrush}"/>
            <Setter Property="Background" Value="{StaticResource DarkBlueColorBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource WhiteColorBrush}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2 4 2 4"/>
            <Setter Property="Padding" Value="10 0 10 1"/>
        </Style>
        <Style x:Key="LargeIcon" TargetType="Image">
            <Setter Property="Margin" Value="8 8 8 0"/>
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="64"/>
        </Style>
        <Style x:Key="SmallIcon" TargetType="Image">
            <Setter Property="Margin" Value="4 2 0 2"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
        </Style>
        <Style x:Key="SmallIconWithoutLabel" TargetType="Image">
            <Setter Property="Margin" Value="2 2 2 2"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="BorderBrush" Value="{StaticResource TransparentColorBrush}"/>
            <Setter Property="Background" Value="{StaticResource DarkBlueColorBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource WhiteColorBrush}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2 4 2 4"/>
            <Setter Property="Padding" Value="1 0 1 0"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Style.Setters>
                <Setter Property="BorderBrush" Value="{StaticResource TransparentColorBrush}"/>
                <Setter Property="Background" Value="{StaticResource DarkBlueColorBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource WhiteColorBrush}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style.Setters>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource LightBlueColorBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource LighterBlueColorBrush}"/>
                </Trigger>
            </Style.Triggers>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="0"/>
                </Style>
            </Style.Resources>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="BorderBrush" Value="{StaticResource DarkBlueColorBrush}"/>
            <Setter Property="Background" Value="{StaticResource DarkBlueColorBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Style.Setters>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8 4 8 4"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style.Setters>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource LighterBlueColorBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow" x:Key="DataGridRowStyle">
            <Style.Setters>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="{StaticResource DarkBlueColorBrush}"/>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
            </Style.Setters>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource LightBlueColorBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource LighterBlueColorBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="BorderBrush" Value="{StaticResource LightBlueColorBrush}"/>
            <Setter Property="BorderThickness" Value="0 0 2 0"/>
            <Setter Property="Background" Value="{StaticResource DarkBlueColorBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="Padding" Value="8 4 8 4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TreeView">
            <Style.Setters>
                <Setter Property="Background" Value="{StaticResource DarkBlueColorBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource DarkBlueColorBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource WhiteColorBrush}"/>
            </Style.Setters>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="0"/>
                </Style>
            </Style.Resources>
        </Style>
        <!--
        <Style TargetType="TreeViewItem">
            <Style.Setters>
                <Setter Property="Background" Value="{StaticResource DarkBlueColorBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource WhiteColorBrush}"/>
            </Style.Setters>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource LightBlueColorBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource LighterBlueColorBrush}"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="Background" Value="{StaticResource LighterBlueColorBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        -->
        <Style TargetType="GridSplitter">
            <Style.Setters>
                <Setter Property="Width" Value="5"/>
                <Setter Property="Background" Value="{StaticResource LightBlueColorBrush}"/>
            </Style.Setters>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="0"/>
                </Style>
            </Style.Resources>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Background" Value="{StaticResource LighterBlueColorBrush}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="BorderBrush" Value="{StaticResource TransparentColorBrush}"/>
            <Setter Property="Background" Value="{StaticResource DarkBlueColorBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource WhiteColorBrush}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2 0 2 0"/>
            <Setter Property="Padding" Value="10 0 10 0"/>
        </Style>
        <!-- #endregion -->
        <!-- #region Custom ComboBox -->
        <SolidColorBrush x:Key="ComboBox.Static.Background" Color="{StaticResource DarkBlueColor}"/>
        <SolidColorBrush x:Key="ComboBox.Static.Border" Color="{StaticResource DarkBlueColor}"/>
        <SolidColorBrush x:Key="ComboBox.Static.Glyph" Color="{StaticResource WhiteColor}"/>
        <SolidColorBrush x:Key="ComboBox.Static.Editable.Background" Color="{StaticResource DarkBlueColor}"/>
        <SolidColorBrush x:Key="ComboBox.Static.Editable.Border" Color="{StaticResource DarkBlueColor}"/>
        <SolidColorBrush x:Key="ComboBox.Static.Editable.Button.Background" Color="{StaticResource TransparentColor}"/>
        <SolidColorBrush x:Key="ComboBox.Static.Editable.Button.Border" Color="{StaticResource TransparentColor}"/>
        <SolidColorBrush x:Key="ComboBox.MouseOver.Background" Color="{StaticResource LighterBlueColor}"/>
        <SolidColorBrush x:Key="ComboBox.MouseOver.Border" Color="{StaticResource LighterBlueColor}"/>
        <SolidColorBrush x:Key="ComboBox.MouseOver.Glyph" Color="{StaticResource WhiteColor}"/>
        <SolidColorBrush x:Key="ComboBox.MouseOver.Editable.Background" Color="{StaticResource DarkBlueColor}"/>
        <SolidColorBrush x:Key="ComboBox.MouseOver.Editable.Border" Color="{StaticResource DarkBlueColor}"/>
        <SolidColorBrush x:Key="ComboBox.MouseOver.Editable.Button.Background" Color="{StaticResource TransparentColor}"/>
        <SolidColorBrush x:Key="ComboBox.MouseOver.Editable.Button.Border" Color="{StaticResource TransparentColor}"/>
        <SolidColorBrush x:Key="ComboBox.Pressed.Background" Color="{StaticResource DarkBlueColor}"/>
        <SolidColorBrush x:Key="ComboBox.Pressed.Border" Color="{StaticResource LighterBlueColor}"/>
        <SolidColorBrush x:Key="ComboBox.Pressed.Glyph" Color="{StaticResource WhiteColor}"/>
        <SolidColorBrush x:Key="ComboBox.Pressed.Editable.Background" Color="{StaticResource DarkBlueColor}"/>
        <SolidColorBrush x:Key="ComboBox.Pressed.Editable.Border" Color="{StaticResource DarkBlueColor}"/>
        <SolidColorBrush x:Key="ComboBox.Pressed.Editable.Button.Background" Color="{StaticResource TransparentColor}"/>
        <SolidColorBrush x:Key="ComboBox.Pressed.Editable.Button.Border" Color="{StaticResource TransparentColor}"/>
        <SolidColorBrush x:Key="ComboBox.Disabled.Background" Color="{StaticResource DarkBlueColor}"/>
        <SolidColorBrush x:Key="ComboBox.Disabled.Border" Color="{StaticResource DarkBlueColor}"/>
        <SolidColorBrush x:Key="ComboBox.Disabled.Glyph" Color="{StaticResource WhiteColor}"/>
        <SolidColorBrush x:Key="ComboBox.Disabled.Editable.Background" Color="{StaticResource DarkBlueColor}"/>
        <SolidColorBrush x:Key="ComboBox.Disabled.Editable.Border" Color="{StaticResource DarkBlueColor}"/>
        <SolidColorBrush x:Key="ComboBox.Disabled.Editable.Button.Background" Color="{StaticResource TransparentColor}"/>
        <SolidColorBrush x:Key="ComboBox.Disabled.Editable.Button.Border" Color="{StaticResource TransparentColor}"/>
        <Style x:Key="ComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Focusable" Value="false"/>
            <Setter Property="ClickMode" Value="Press"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="templateRoot" Background="{StaticResource ComboBox.Static.Background}" BorderBrush="{StaticResource ComboBox.Static.Border}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="true">
                            <Border x:Name="splitBorder" BorderBrush="Transparent" BorderThickness="1" HorizontalAlignment="Right" Margin="0" SnapsToDevicePixels="true" Width="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}">
                                <Path x:Name="arrow" Data="F1 M 0,0 L 2.667,2.66665 L 5.3334,0 L 5.3334,-1.78168 L 2.6667,0.88501 L0,-1.78168 L0,0 Z" Fill="{StaticResource ComboBox.Static.Glyph}" HorizontalAlignment="Center" Margin="0" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsEditable, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" Value="true"/>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="false"/>
                                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="false"/>
                                    <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="true"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" TargetName="templateRoot" Value="{StaticResource ComboBox.Static.Editable.Background}"/>
                                <Setter Property="BorderBrush" TargetName="templateRoot" Value="{StaticResource ComboBox.Static.Editable.Border}"/>
                                <Setter Property="Background" TargetName="splitBorder" Value="{StaticResource ComboBox.Static.Editable.Button.Background}"/>
                                <Setter Property="BorderBrush" TargetName="splitBorder" Value="{StaticResource ComboBox.Static.Editable.Button.Border}"/>
                            </MultiDataTrigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Fill" TargetName="arrow" Value="{StaticResource ComboBox.MouseOver.Glyph}"/>
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="true"/>
                                    <Condition Binding="{Binding IsEditable, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" Value="false"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" TargetName="templateRoot" Value="{StaticResource ComboBox.MouseOver.Background}"/>
                                <Setter Property="BorderBrush" TargetName="templateRoot" Value="{StaticResource ComboBox.MouseOver.Border}"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="true"/>
                                    <Condition Binding="{Binding IsEditable, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" Value="true"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" TargetName="templateRoot" Value="{StaticResource ComboBox.MouseOver.Editable.Background}"/>
                                <Setter Property="BorderBrush" TargetName="templateRoot" Value="{StaticResource ComboBox.MouseOver.Editable.Border}"/>
                                <Setter Property="Background" TargetName="splitBorder" Value="{StaticResource ComboBox.MouseOver.Editable.Button.Background}"/>
                                <Setter Property="BorderBrush" TargetName="splitBorder" Value="{StaticResource ComboBox.MouseOver.Editable.Button.Border}"/>
                            </MultiDataTrigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter Property="Fill" TargetName="arrow" Value="{StaticResource ComboBox.Pressed.Glyph}"/>
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="true"/>
                                    <Condition Binding="{Binding IsEditable, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" Value="false"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" TargetName="templateRoot" Value="{StaticResource ComboBox.Pressed.Background}"/>
                                <Setter Property="BorderBrush" TargetName="templateRoot" Value="{StaticResource ComboBox.Pressed.Border}"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="true"/>
                                    <Condition Binding="{Binding IsEditable, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" Value="true"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" TargetName="templateRoot" Value="{StaticResource ComboBox.Pressed.Editable.Background}"/>
                                <Setter Property="BorderBrush" TargetName="templateRoot" Value="{StaticResource ComboBox.Pressed.Editable.Border}"/>
                                <Setter Property="Background" TargetName="splitBorder" Value="{StaticResource ComboBox.Pressed.Editable.Button.Background}"/>
                                <Setter Property="BorderBrush" TargetName="splitBorder" Value="{StaticResource ComboBox.Pressed.Editable.Button.Border}"/>
                            </MultiDataTrigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Fill" TargetName="arrow" Value="{StaticResource ComboBox.Disabled.Glyph}"/>
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
