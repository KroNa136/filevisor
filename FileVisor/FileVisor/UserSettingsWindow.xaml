<Window x:Name="userSettingsWindow" x:Class="FileVisor.UserSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FileVisor"
        mc:Ignorable="d"
        Title="Настройки" Icon="{StaticResource SettingsIcon}" Height="294" Width="660" ResizeMode="CanMinimize" ShowInTaskbar="True" WindowStartupLocation="CenterScreen" FontSize="16" WindowStyle="SingleBorderWindow" BorderThickness="1" BorderBrush="{StaticResource DarkBlueColorBrush}" RenderOptions.EdgeMode="Aliased" RenderOptions.ClearTypeHint="Enabled">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="5" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="wrapper" Style="{StaticResource LightPanel}">
        <Grid x:Name="userSettingsWindowGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <DockPanel x:Name="titleBar" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Style="{StaticResource LightPanel}" Focusable="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Image Style="{StaticResource SmallIcon}" Source="{StaticResource SettingsIcon}"/>
                    <TextBlock x:Name="titleTextBlock" Style="{StaticResource TitleTextBlock}" Text="Настройки"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" FlowDirection="RightToLeft">
                    <Button x:Name="closeButton" Grid.Column="1" Style="{StaticResource TitleBarCloseButton}" WindowChrome.IsHitTestVisibleInChrome="True" Click="closeButton_Click">
                        <Image Style="{StaticResource SmallIconWithoutLabel}" Source="{StaticResource CloseIcon}"/>
                    </Button>
                    <Button x:Name="restoreButton" Grid.Column="1" Style="{StaticResource TitleBarButton}" WindowChrome.IsHitTestVisibleInChrome="True" Click="restoreButton_Click" Visibility="Collapsed">
                        <Image Style="{StaticResource SmallIconWithoutLabel}" Source="{StaticResource RestoreIcon}"/>
                    </Button>
                    <Button x:Name="maximizeButton" Grid.Column="1" Style="{StaticResource TitleBarButton}" WindowChrome.IsHitTestVisibleInChrome="True" Click="maximizeButton_Click" Visibility="Visible" IsEnabled="False">
                        <Image Style="{StaticResource SmallIconWithoutLabel}" Source="{StaticResource MaximizeIcon}"/>
                    </Button>
                    <Button x:Name="minimizeButton" Grid.Column="1" Style="{StaticResource TitleBarButton}" WindowChrome.IsHitTestVisibleInChrome="True" Click="minimizeButton_Click">
                        <Image Style="{StaticResource SmallIconWithoutLabel}" Source="{StaticResource MinimizeIcon}"/>
                    </Button>
                </StackPanel>
            </DockPanel>
            <Grid x:Name="mainPanel" Grid.Row="1" Style="{StaticResource LightPanel}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="5 5 5 5">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Vertical" Margin="5 5 5 5">
                        <StackPanel Orientation="Horizontal">
                            <Image Style="{StaticResource SmallIcon}" Source="{StaticResource SortColumnIcon}"/>
                            <TextBlock Style="{StaticResource InlineTextBlock}" Text="Поле для сортировки:"/>
                        </StackPanel>
                        <ComboBox x:Name="sortColumnComboBox" Template="{DynamicResource CustomComboBoxTemplate}" ItemsSource="{Binding SortColumns}" SelectedValuePath="ID" SelectedValue="{Binding SelectedSortColumnID}" SelectionChanged="sortColumnComboBox_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource ComboBoxTextBlock}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Vertical" Margin="5 5 5 5">
                        <StackPanel Orientation="Horizontal">
                            <Image Style="{StaticResource SmallIcon}" Source="{StaticResource SortDirectionIcon}"/>
                            <TextBlock Style="{StaticResource InlineTextBlock}" Text="Направление сортировки:"/>
                        </StackPanel>
                        <ComboBox x:Name="sortDirectionComboBox" Template="{DynamicResource CustomComboBoxTemplate}" ItemsSource="{Binding SortDirections}" SelectedValuePath="ID" SelectedValue="{Binding SelectedSortDirectionID}" SelectionChanged="sortDirectionComboBox_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource ComboBoxTextBlock}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <Grid Grid.Column="1" Margin="5 5 5 5">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <CheckBox x:Name="showFileExtensionsCheckBox" Template="{DynamicResource CustomCheckBoxTemplate}" Grid.Row="0" IsChecked="{Binding ShowFileExtensions}" Checked="showFileExtensionsCheckBox_Checked" Unchecked="showFileExtensionsCheckBox_Unchecked">
                        <TextBlock Text="Отображать расширения файлов"/>
                    </CheckBox>
                    <CheckBox x:Name="showHiddenElementsCheckBox" Template="{DynamicResource CustomCheckBoxTemplate}" Grid.Row="1" IsChecked="{Binding ShowHiddenElements}" Checked="showHiddenElementsCheckBox_Checked" Unchecked="showHiddenElementsCheckBox_Unchecked">
                        <TextBlock Text="Отображать скрытые файлы"/>
                    </CheckBox>
                    <CheckBox x:Name="showSystemElementsCheckBox" Template="{DynamicResource CustomCheckBoxTemplate}" Grid.Row="2" IsChecked="{Binding ShowSystemElements}" Checked="showSystemElementsCheckBox_Checked" Unchecked="showSystemElementsCheckBox_Unchecked">
                        <TextBlock Text="Отображать системные файлы"/>
                    </CheckBox>
                    <CheckBox x:Name="oldSystemPropertiesViewCheckBox" Template="{DynamicResource CustomCheckBoxTemplate}" Grid.Row="3" IsChecked="{Binding OldSystemPropertiesView}" Checked="oldSystemPropertiesViewCheckBox_Checked" Unchecked="oldSystemPropertiesViewCheckBox_Unchecked">
                        <TextBlock Text="Классический вид свойств системы"/>
                    </CheckBox>
                </Grid>
            </Grid>
            <Grid x:Name="buttonPanel" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" Style="{StaticResource LightPanel}" Focusable="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="okButton" Style="{StaticResource TextButton}" HorizontalAlignment="Right" IsDefault="True" Click="okButton_Click">
                    <TextBlock Text="ОК"/>
                </Button>
                <Button Grid.Column="1" x:Name="cancelButton" Style="{StaticResource TextButton}" HorizontalAlignment="Center" Click="cancelButton_Click">
                    <TextBlock Text="Отмена"/>
                </Button>
                <Button Grid.Column="2" x:Name="applyButton" Style="{StaticResource TextButton}" HorizontalAlignment="Left" Click="applyButton_Click" IsEnabled="False">
                    <TextBlock Text="Применить"/>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
